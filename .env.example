# Copy to .env and fill. Never commit real secrets.

# API auth — Bearer token for POST /compare and GET /compare/{job_id}
# Leave empty to disable auth in local dev.
API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# AWS (Textract OCR + S3 artifact storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=

# Redis (RQ job queue + status cache)
REDIS_URL=redis://localhost:6379/0

# SOLIDWORKS integration (optional — only needed for --source solidworks)
# URL of the swcompare/ Windows service. Empty disables the SW source.
SOLIDWORKS_SERVICE_URL=
# Dimension delta below this (mm) is MINOR; above is MAJOR; ≥1mm or ≥10% is CRITICAL.
SW_DIM_THRESHOLD_MM=0.1
# For .SLDDRW: also run vision pipeline on the exported sheet PDFs.
SW_EXPORT_DRAWINGS=true
# HTTP timeout for the SOLIDWORKS service.
SW_REQUEST_TIMEOUT_S=60
# When true, ignore severity from the service and recompute in Python.
SW_RECLASSIFY=false
