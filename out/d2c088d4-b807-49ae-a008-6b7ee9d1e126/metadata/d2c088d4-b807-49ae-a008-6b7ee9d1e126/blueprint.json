{
  "html_shell": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Engineering Change Order (ECO)</title>\n<style>\n  @page {\n    size: A4;\n    margin: 2.5cm 2.5cm 2.5cm 2.5cm;\n  }\n  * {\n    box-sizing: border-box;\n    margin: 0;\n    padding: 0;\n  }\n  body {\n    font-family: \"Times New Roman\", Times, serif;\n    font-size: 11pt;\n    color: #000;\n    background: #fff;\n    padding: 2.5cm;\n    max-width: 21cm;\n    margin: 0 auto;\n  }\n  h1.doc-title {\n    text-align: center;\n    font-size: 20pt;\n    font-weight: bold;\n    margin-bottom: 2.5em;\n    margin-top: 1em;\n  }\n  h2.section-heading {\n    font-size: 14pt;\n    font-weight: bold;\n    margin-bottom: 0.5em;\n    margin-top: 1.8em;\n  }\n  p.section-intro {\n    font-size: 10pt;\n    margin-bottom: 0.8em;\n  }\n  table.info-table {\n    width: 100%;\n    border-collapse: collapse;\n    margin-bottom: 1.5em;\n  }\n  table.info-table td {\n    border: 1px solid #000;\n    padding: 8px 10px;\n    vertical-align: top;\n    font-size: 10.5pt;\n  }\n  table.info-table td.label {\n    font-weight: bold;\n    width: 38%;\n  }\n  table.info-table td.value {\n    width: 62%;\n    min-height: 28px;\n  }\n  table.changes-table {\n    width: 100%;\n    border-collapse: collapse;\n    margin-bottom: 1.5em;\n    margin-top: 0.5em;\n  }\n  table.changes-table th {\n    border: 1px solid #000;\n    padding: 6px 10px;\n    font-weight: bold;\n    font-size: 10.5pt;\n    text-align: left;\n    background: #fff;\n  }\n  table.changes-table td {\n    border: 1px solid #000;\n    padding: 28px 10px 28px 6px;\n    font-size: 10.5pt;\n    vertical-align: top;\n  }\n  table.changes-table td.num {\n    width: 6%;\n    vertical-align: top;\n    padding: 6px 6px;\n  }\n  table.changes-table th.num {\n    width: 6%;\n  }\n  table.impact-table {\n    width: 100%;\n    border-collapse: collapse;\n    margin-bottom: 1.5em;\n  }\n  table.impact-table th {\n    border: 1px solid #000;\n    padding: 6px 10px;\n    font-weight: bold;\n    font-size: 10.5pt;\n    text-align: left;\n    background: #fff;\n  }\n  table.impact-table td {\n    border: 1px solid #000;\n    padding: 28px 10px 28px 10px;\n    font-size: 10.5pt;\n    vertical-align: top;\n  }\n  table.impact-table td.cat {\n    width: 38%;\n  }\n  table.approval-table {\n    width: 100%;\n    border-collapse: collapse;\n    margin-bottom: 1.5em;\n  }\n  table.approval-table th {\n    border: 1px solid #000;\n    padding: 6px 10px;\n    font-weight: bold;\n    font-size: 10.5pt;\n    text-align: left;\n    background: #fff;\n  }\n  table.approval-table td {\n    border: 1px solid #000;\n    padding: 28px 10px 28px 10px;\n    font-size: 10.5pt;\n    vertical-align: top;\n  }\n  .diagrams-section {\n    margin-top: 1.5em;\n  }\n  .diagram-label {\n    font-weight: bold;\n    font-size: 10.5pt;\n    margin-bottom: 0.4em;\n    margin-top: 1em;\n  }\n  .diagram-box {\n    width: 100%;\n    min-height: 130px;\n    border-bottom: 1px solid #000;\n    margin-bottom: 0.5em;\n    padding-bottom: 1em;\n  }\n  .page-break {\n    page-break-before: always;\n  }\n  .page-number {\n    text-align: center;\n    font-size: 10pt;\n    margin-top: 2em;\n  }\n  .end-note {\n    text-align: center;\n    font-style: italic;\n    font-size: 11pt;\n    margin-top: 4em;\n    margin-bottom: 1em;\n  }\n  .summary-section {\n    margin-top: 1em;\n    margin-bottom: 1em;\n  }\n  .title-block-section {\n    margin-top: 1em;\n  }\n  .revision-block-section {\n    margin-top: 1em;\n  }\n  .notes-block {\n    font-size: 10.5pt;\n    margin-bottom: 1em;\n    min-height: 3em;\n  }\n  /* Severity row/cell coloring */\n  .sev-CRITICAL {\n    background-color: #ffd6d6;\n  }\n  .sev-SIGNIFICANT {\n    background-color: #ffe8c0;\n  }\n  .sev-MINOR {\n    background-color: #e8e8e8;\n  }\n  .sev-UNCERTAIN {\n    background-color: #fffbcc;\n  }\n  p.watermark {\n    color: red;\n    font-style: italic;\n    font-size: 8pt;\n    text-align: center;\n    margin-top: 2em;\n  }\n</style>\n</head>\n<body>\n\n<!-- PAGE 1 -->\n<h1 class=\"doc-title\">Engineering Change Order (ECO)</h1>\n\n<h2 class=\"section-heading\">Document Information</h2>\n<table class=\"info-table\">\n  <tr>\n    <td class=\"label\">ECO Number</td>\n    <td class=\"value\">[[JOB_ID]]</td>\n  </tr>\n  <tr>\n    <td class=\"label\">Project / Product Name</td>\n    <td class=\"value\">[[TITLE]]</td>\n  </tr>\n  <tr>\n    <td class=\"label\">Prepared By</td>\n    <td class=\"value\">&nbsp;</td>\n  </tr>\n  <tr>\n    <td class=\"label\">Date Submitted</td>\n    <td class=\"value\">[[GENERATED_AT]]</td>\n  </tr>\n  <tr>\n    <td class=\"label\">Revision Number</td>\n    <td class=\"value\">[[PART_NUMBER]]</td>\n  </tr>\n  <tr>\n    <td class=\"label\">Priority Level</td>\n    <td class=\"value\">&nbsp;</td>\n  </tr>\n  <tr>\n    <td class=\"label\">Departments Affected</td>\n    <td class=\"value\">&nbsp;</td>\n  </tr>\n</table>\n\n<h2 class=\"section-heading\">Change Summary</h2>\n<p class=\"section-intro\">Briefly describe the purpose and scope of the proposed engineering change.</p>\n<div class=\"summary-section\">[[SUMMARY]]</div>\n<div class=\"notes-block\">[[NOTES]]</div>\n\n<div class=\"title-block-section\">[[TITLE_BLOCK]]</div>\n\n<div class=\"revision-block-section\">[[REVISION_BLOCK]]</div>\n\n<h2 class=\"section-heading\">List of Changes</h2>\n[[CHANGES]]\n\n<div class=\"page-number\">1</div>\n\n<!-- PAGE 2 -->\n<div class=\"page-break\"></div>\n\n<div class=\"diagrams-section\">\n  <h2 class=\"section-heading\">Supporting Images / Diagrams</h2>\n  <div class=\"diagram-label\">Before Change</div>\n  <div class=\"diagram-box\">[[DRAWINGS]]</div>\n  <div class=\"diagram-label\">After Change</div>\n  <div class=\"diagram-box\">&nbsp;</div>\n</div>\n\n<div class=\"page-number\">2</div>\n\n<!-- PAGE 3 -->\n<div class=\"page-break\"></div>\n\n<h2 class=\"section-heading\">Impact Analysis</h2>\n<table class=\"impact-table\">\n  <tr>\n    <th>Category</th>\n    <th>Impact Notes</th>\n  </tr>\n  <tr>\n    <td class=\"cat\">Cost Impact</td>\n    <td>&nbsp;</td>\n  </tr>\n  <tr>\n    <td class=\"cat\">Schedule Impact</td>\n    <td>&nbsp;</td>\n  </tr>\n  <tr>\n    <td class=\"cat\">Manufacturing Impact</td>\n    <td>&nbsp;</td>\n  </tr>\n  <tr>\n    <td class=\"cat\">Testing / Validation Required</td>\n    <td>&nbsp;</td>\n  </tr>\n</table>\n\n<h2 class=\"section-heading\">Approval and Sign-Off</h2>\n<table class=\"approval-table\">\n  <tr>\n    <th>Name / Role</th>\n    <th>Signature</th>\n    <th>Date</th>\n  </tr>\n  <tr>\n    <td>Engineering Lead</td>\n    <td>&nbsp;</td>\n    <td>&nbsp;</td>\n  </tr>\n  <tr>\n    <td>Quality Assurance</td>\n    <td>&nbsp;</td>\n    <td>&nbsp;</td>\n  </tr>\n  <tr>\n    <td>Manufacturing</td>\n    <td>&nbsp;</td>\n    <td>&nbsp;</td>\n  </tr>\n  <tr>\n    <td>Project Manager</td>\n    <td>&nbsp;</td>\n    <td>&nbsp;</td>\n  </tr>\n</table>\n\n<div class=\"end-note\">End of Engineering Change Order</div>\n\n<div class=\"page-number\">3</div>\n\n<p class=\"watermark\">&#9888; AI-generated &mdash; requires human verification.</p>\n\n</body>\n</html>",
  "change_table": {
    "columns": [
      {
        "header": "#",
        "role": "other"
      },
      {
        "header": "Component / Area",
        "role": "field"
      },
      {
        "header": "Description of Change",
        "role": "description"
      }
    ],
    "has_zone_column": false
  },
  "severity_labels": {
    "CRITICAL": "Critical",
    "MAJOR": "Significant",
    "MINOR": "Minor",
    "UNCERTAIN": "Review"
  }
}